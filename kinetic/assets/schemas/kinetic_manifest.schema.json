{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KineticManifestSOTA",
  "type": "object",
  "required": ["engine", "brand", "selected_animation_id", "bound_symbol_parts", "pb19_compliance", "dtcg_tokens", "presets", "astro_lifecycle_ts", "assets"],
  "properties": {
    "engine": { "type": "string" },
    "brand": { "type": "string" },
    "generated_at": { "type": "string" },
    "selected_animation_id": { "type": "string" },
    "bound_symbol_parts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "pb19_compliance": {
      "type": "object",
      "required": ["gpu_composited_only", "zero_layout_thrashing", "prefers_reduced_motion_enforced"],
      "properties": {
        "gpu_composited_only": { "type": "boolean", "const": true },
        "zero_layout_thrashing": { "type": "boolean", "const": true },
        "prefers_reduced_motion_enforced": { "type": "boolean", "const": true },
        "zero_bounce_elastic": { "type": "boolean" }
      }
    },
    "dtcg_tokens": { "type": "object" },
    "presets": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name", "css_class", "duration_ms", "easing", "targets", "gpu_properties"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "css_class": { "type": "string" },
          "duration_ms": { "type": "integer" },
          "easing": { "type": "string" },
          "targets": { "type": "array", "items": { "type": "string" } },
          "gpu_properties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "astro_lifecycle_ts": { "type": "string" },
    "assets": { "type": "object" }
  }
}
