{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FontManifestSOTA",
  "type": "object",
  "required": ["brand", "selected_ecosystem_id", "candidate_ecosystems", "inheritance"],
  "properties": {
    "brand": { "type": "string", "description": "Nombre de la marca o proyecto" },
    "vertical_slug": { "type": "string" },
    "selected_ecosystem_id": { "type": "string" },
    "style_profile": { "type": "string" },
    "has_oraculo": { "type": "boolean" },
    "candidate_ecosystems": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name", "archetype", "rationale", "tokens"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "archetype": { "type": "string" },
          "scale_ratio": { "type": "number" },
          "rationale": { "type": "string" },
          "tokens": {
            "type": "object",
            "required": ["display_primary", "ui_secondary", "accent_brand"],
            "properties": {
              "display_primary": { "$ref": "#/$defs/FontToken" },
              "ui_secondary": { "$ref": "#/$defs/FontToken" },
              "accent_brand": { "$ref": "#/$defs/FontToken" }
            }
          },
          "layers": {
            "type": "object",
            "properties": {
              "logo": { "type": "string" },
              "slogan": { "type": "string" },
              "h1": { "type": "string" },
              "h2": { "type": "string" },
              "body": { "type": "string" },
              "ui": { "type": "string" }
            }
          },
          "cls_metric_overrides": {
            "type": "object",
            "required": ["fallback_font", "size_adjust", "ascent_override", "descent_override", "line_gap_override"],
            "properties": {
              "fallback_font": { "type": "string" },
              "size_adjust": { "type": "string", "pattern": "^[0-9.]+(%)?$" },
              "ascent_override": { "type": "string", "pattern": "^[0-9.]+(%)?$" },
              "descent_override": { "type": "string", "pattern": "^[0-9.]+(%)?$" },
              "line_gap_override": { "type": "string", "pattern": "^[0-9.]+(%)?$" },
              "display": { "type": "object" },
              "body": { "type": "object" }
            }
          },
          "workbench_presets": {
            "type": "object",
            "properties": {
              "font_size_px": { "type": "number" },
              "letter_spacing_em": { "type": "number" },
              "line_height": { "type": "number" },
              "text_transform": { "type": "string", "enum": ["none", "uppercase", "lowercase", "capitalize"] },
              "font_weight": { "type": "string" },
              "ligatures_enabled": { "type": "boolean" }
            }
          }
        }
      }
    },
    "selected_ecosystem": { "type": "object" },
    "web_ready_bridge": { "type": "object" },
    "astro_web_ready": {
      "type": "object",
      "properties": {
        "astro_fonts_entries": { "type": "array" },
        "astro_fonts_config": { "type": "string" },
        "css_typography_system": { "type": "string" }
      }
    },
    "dtcg_tokens": { "type": "object" },
    "brandfont_export": { "type": "object" },
    "inheritance": {
      "type": "object",
      "required": ["logo", "slogan", "h1", "h2", "body"],
      "properties": {
        "logo": { "type": "string" },
        "slogan": { "type": "string" },
        "h1": { "type": "string" },
        "h2": { "type": "string" },
        "body": { "type": "string" },
        "ui": { "type": "string" },
        "ui_buttons": { "type": "string" }
      }
    }
  },
  "$defs": {
    "FontToken": {
      "type": "object",
      "required": ["$value", "source"],
      "properties": {
        "$value": { "type": "string" },
        "$type": { "type": "string", "default": "fontFamily" },
        "$description": { "type": "string" },
        "source": { "type": "string", "enum": ["envato", "google_fonts", "local_upload"] },
        "url": { "type": "string" },
        "weights": { "type": "array", "items": { "type": "string" } },
        "variable_axes": { "type": "string" },
        "google_fonts_v2_url": { "type": "string" }
      }
    }
  }
}
