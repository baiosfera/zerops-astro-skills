{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "source_of_truth": "split",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "env_label": "PROD",
  "setup_token": "env.BIFROST_SETUP_TOKEN",
  "server": {
    "read_buffer_size": 65536,
    "plugin_download_private_allowlist": []
  },
  "client": {
    "initial_pool_size": 1000,
    "drop_excess_requests": false,
    "enable_logging": true,
    "log_retention_days": 30,
    "enforce_auth_on_inference": true,
    "allowed_origins": ["*"],
    "allowed_headers": ["Content-Type", "Authorization", "X-Api-Key", "x-bf-vk", "x-bf-dim-*"]
  },
  "vector_store": {
    "enabled": true,
    "type": "chromem"
  },
  "mcp": {
    "client_configs": [
      {
        "name": "freellmapi-mcp",
        "connection_type": "http",
        "connection_string": "http://freellmapi:3001/mcp",
        "tools_to_execute": ["*"],
        "tools_to_auto_execute": ["list_models", "provider_health", "usage_summary"]
      }
    ],
    "tool_manager_config": {
      "max_agent_depth": 10,
      "tool_execution_timeout": "30s"
    }
  },
  "providers": {
    "freellmapi": {
      "base_provider_type": "openai",
      "base_url": "http://freellmapi:3001/v1",
      "custom_provider_config": {
        "enabled": true,
        "api_type": "openai_compatible"
      },
      "keys": [
        {
          "name": "freellmapi-primary",
          "value": "env.FREELLMAPI_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 60,
        "max_retries": 2
      }
    },
    "pro": {
      "base_provider_type": "openai",
      "base_url": "env.PRO_BASE_URL",
      "keys": [
        {
          "name": "pro-primary",
          "value": "env.PRO_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 120,
        "max_retries": 3
      }
    }
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "disable_auth_on_inference": false
    },
    "virtual_keys": [
      {
        "id": "vk-production-main",
        "name": "production-service-key",
        "value": "env.PROD_VIRTUAL_KEY",
        "is_active": true,
        "rate_limit_id": "rl-standard",
        "calendar_aligned": true,
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "pro",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ],
        "mcp_configs": [
          {
            "mcp_client_name": "freellmapi-mcp",
            "tools_to_execute": ["*"]
          }
        ]
      }
    ],
    "budgets": [
      {
        "id": "budget-monthly-production",
        "max_limit": 1000.0,
        "reset_duration": "1M",
        "virtual_key_id": "vk-production-main"
      }
    ],
    "rate_limits": [
      {
        "id": "rl-standard",
        "request_max_limit": 10000,
        "request_reset_duration": "1h",
        "token_max_limit": 10000000,
        "token_reset_duration": "1h"
      }
    ],
    "circuit_breakers": [
      {
        "id": "freellmapi-exhaustion-breaker",
        "provider": "freellmapi",
        "triggers": {
          "status_codes": [429, 500, 502, 503],
          "header_triggers": [
            {
              "source": "response_header",
              "header_name": "retry-after"
            },
            {
              "source": "response_header",
              "header_name": "x-ratelimit-remaining",
              "header_value": "0"
            }
          ]
        },
        "default_cooldown": "60s",
        "cooldown_header": "retry-after"
      }
    ],
    "routing_rules": [
      {
        "id": "rule-explicit-pro-override",
        "name": "Route Explicit Pro Tier Requests Directly to Pro",
        "cel_expression": "headers['x-force-deepseek'] == 'true' || headers['x-tier'] == 'pro' || headers['x-routing-tier'] == 'pro'",
        "targets": [
          {
            "provider": "pro",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "freellmapi"
        ],
        "priority": 0
      },
      {
        "id": "rule-zero-cost-freellm-universal",
        "name": "Prioritize FreeLLMAPI ($0) for All Models (Chat, Code, Reasoning) with Paid Failover",
        "cel_expression": "true",
        "targets": [
          {
            "provider": "freellmapi",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          "pro"
        ],
        "priority": 1
      }
    ]
  }
}
