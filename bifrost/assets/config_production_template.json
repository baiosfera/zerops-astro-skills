{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "server": {
    "port": 8080,
    "host": "0.0.0.0"
  },
  "client": {
    "enforce_auth_on_inference": false
  },
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.PG_HOST",
      "port": "5432",
      "user": "env.PG_USER",
      "password": "env.PG_PASSWORD",
      "db_name": "env.PG_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "env.PG_HOST",
      "port": "5432",
      "user": "env.PG_USER",
      "password": "env.PG_PASSWORD",
      "db_name": "env.PG_DATABASE",
      "ssl_mode": "disable"
    }
  },
  "vector_store": {
    "enabled": true,
    "type": "chromem",
    "config": {
      "path": "/mnt/localstorage/bifrost/chromem",
      "compress": true
    }
  },
  "plugins": [
    {
      "name": "semantic_cache",
      "enabled": true,
      "config": {
        "dimension": 1,
        "ttl": 86400,
        "threshold": 0.8,
        "vector_store_namespace": "BifrostLocalCache",
        "default_cache_key": "production-semantic-cache",
        "cache_by_model": true,
        "cache_by_provider": true
      }
    }
  ],
  "providers": {
    "freellmapi": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "keys": [
        {
          "name": "freellmapi-primary-pool",
          "value": "env.FREELLMAPI_UNIFIED_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://freellmapi:3001",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 120,
        "max_retries": 2,
        "retry_backoff_initial": 300,
        "retry_backoff_max": 1000
      }
    },
    "deepseek": {
      "keys": [
        {
          "name": "deepseek-pro-commercial",
          "value": "env.DEEPSEEK_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 3000
      }
    }
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "disable_auth_on_inference": false
    },
    "virtual_keys": [
      {
        "id": "vk-production-main",
        "name": "Production Sovereign Key",
        "value": "env.BIFROST_VIRTUAL_KEY",
        "is_active": true,
        "rate_limits": {
          "requests_per_minute": 120
        },
        "provider_configs": [
          {
            "provider": "freellmapi",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          },
          {
            "provider": "deepseek",
            "allowed_models": ["*"],
            "key_ids": ["*"],
            "weight": 1.0
          }
        ]
      }
    ],
    "routing_rules": [
      {
        "id": "rule-explicit-pro-override",
        "name": "Explicit Pro Override to DeepSeek Only When Requested",
        "cel_expression": "headers['x-force-deepseek'] == 'true' || headers['x-routing-tier'] == 'pro' || headers['x-tier'] == 'pro' || headers['x-tier'] == 'production' || model.startsWith('deepseek')",
        "targets": [
          {
            "provider": "deepseek",
            "weight": 1.0
          }
        ],
        "fallbacks": ["freellmapi"],
        "priority": 0
      },
      {
        "id": "rule-freellm-opt-in-paid-fallback",
        "name": "FreeLLMAPI Primary with Opt-In DeepSeek Fallback Only",
        "cel_expression": "headers['x-allow-paid-fallback'] == 'true'",
        "targets": [
          {
            "provider": "freellmapi",
            "weight": 1.0
          }
        ],
        "fallbacks": ["deepseek"],
        "priority": 1
      },
      {
        "id": "rule-freellm-zero-cost-strict",
        "name": "Default Zero-Cost Routing Strictly to FreeLLMAPI",
        "cel_expression": "true",
        "targets": [
          {
            "provider": "freellmapi",
            "weight": 1.0
          }
        ],
        "fallbacks": [],
        "priority": 2
      }
    ]
  }
}
