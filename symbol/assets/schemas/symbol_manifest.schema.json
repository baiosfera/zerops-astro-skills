{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SymbolManifestSOTA",
  "type": "object",
  "required": ["engine", "brand", "normalization", "parts", "selected_vector_id", "assets", "svg_mono", "svg_brand"],
  "properties": {
    "engine": { "type": "string" },
    "brand": { "type": "string" },
    "generated_at": { "type": "string" },
    "source_svg": { "type": "string" },
    "selected_vector_id": { "type": "string" },
    "normalization": {
      "type": "object",
      "required": ["original_viewBox", "normalized_viewBox", "padding_pct"],
      "properties": {
        "original_viewBox": { "type": "string" },
        "normalized_viewBox": { "type": "string", "const": "0 0 100 100" },
        "background_stripped": { "type": ["string", "null"] },
        "padding_pct": { "type": "number" },
        "aspect_ratio_preserved": { "type": "number" }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "index"],
        "properties": {
          "id": { "type": "string" },
          "index": { "type": "integer" }
        }
      }
    },
    "assets": {
      "type": "object",
      "required": ["symbol_mono_svg", "symbol_brand_svg", "favicon_svg", "astro_component"],
      "properties": {
        "symbol_mono_svg": { "type": "string" },
        "symbol_brand_svg": { "type": "string" },
        "favicon_svg": { "type": "string" },
        "astro_component": { "type": "string" }
      }
    },
    "svg_mono": { "type": "string" },
    "svg_brand": { "type": "string" },
    "lockup_ratios": { "type": "object" }
  }
}
